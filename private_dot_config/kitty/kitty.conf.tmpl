# Ported from ~/.wezterm.lua

font_family JetBrainsMono Nerd Font
{{ if eq .chezmoi.os "windows" -}}
shell pwsh
{{ else if eq .chezmoi.os "linux" -}}
shell zsh
{{ end -}}
# WezTerm: config.enable_kitty_keyboard = true
# Kitty uses its own keyboard protocol by default.
{{ if eq .chezmoi.os "linux" -}}
# Dracula color scheme
foreground #f8f8f2
background #282a36
selection_foreground #ffffff
selection_background #44475a

cursor #f8f8f2
cursor_text_color #282a36

color0  #21222c
color1  #ff5555
color2  #50fa7b
color3  #f1fa8c
color4  #bd93f9
color5  #ff79c6
color6  #8be9fd
color7  #f8f8f2
color8  #6272a4
color9  #ff6e6e
color10 #69ff94
color11 #ffffa5
color12 #d6acff
color13 #ff92df
color14 #a4ffff
color15 #ffffff

url_color #8be9fd
active_tab_foreground #282a36
active_tab_background #f8f8f2
inactive_tab_foreground #f8f8f2
inactive_tab_background #44475a
{{ end -}}
