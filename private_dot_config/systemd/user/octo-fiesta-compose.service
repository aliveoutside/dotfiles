[Unit]
Description=Octo Fiesta stack via podman-compose
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/home/oof/Docker/octo-fiesta

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/oof/Docker/octo-fiesta
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecCondition=/usr/bin/test -d /home/oof/Docker/octo-fiesta
ExecCondition=/usr/bin/test -d /media/hdd/Music/!tosort
ExecStart=/usr/bin/podman-compose up -d
ExecStop=/usr/bin/podman-compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=default.target
