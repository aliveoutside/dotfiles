[Unit]
Description=Navidrome stack via podman-compose
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ .chezmoi.homeDir }}/Docker/navidrome /media/hdd/Music

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ .chezmoi.homeDir }}/Docker/navidrome
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecCondition=/usr/bin/test -d {{ .chezmoi.homeDir }}/Docker/navidrome
ExecCondition=/usr/bin/test -d /media/hdd/Music
ExecStart=/usr/bin/podman-compose up -d
ExecStop=/usr/bin/podman-compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=default.target
