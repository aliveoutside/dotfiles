{{- if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.idLike "arch")) -}}
#!/usr/bin/env bash
set -euo pipefail

official_packages=(
{{- range .packages.arch.official }}
  {{ . | quote }}
{{- end }}
)

aur_packages=(
{{- range .packages.arch.aur }}
  {{ . | quote }}
{{- end }}
)

sudo pacman --sync --needed --noconfirm -- "${official_packages[@]}"

if ((${#aur_packages[@]})); then
  if command -v paru >/dev/null 2>&1; then
    paru --sync --needed --noconfirm -- "${aur_packages[@]}"
  elif command -v yay >/dev/null 2>&1; then
    yay --sync --needed --noconfirm -- "${aur_packages[@]}"
  else
    printf 'chezmoi: skipping AUR packages (install paru or yay): %s\n' "${aur_packages[*]}" >&2
  fi
fi
{{- end -}}
